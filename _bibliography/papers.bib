@misc{resck_reliance_2026,
	title = {The {Reliance} {Hypothesis}: {Chain}-of-{Thought} {Faithfulness} {Rises} as {Language} {Resource} {Level} {Falls}},
	copyright = {Creative Commons Attribution 4.0 International},
	shorttitle = {The {Reliance} {Hypothesis}},
	url = {http://arxiv.org/abs/2610.22841},
	doi = {10.48550/arXiv.2610.22841},
	abstract = {Chain-of-Thought (CoT) faithfulness matters for monitoring, explaining and safely deploying large language models, yet it has been studied mostly in English. Languages differ in level, the amount of text available to learn from, so models know less in lower-resource languages, which may change how much they rely on their reasoning. To our knowledge, we are the first to relate CoT faithfulness to both resource level and task type (knowledge- or reasoning-intensive). On parallel multiple-choice questions from Multilingual Massive Multitask Language Understanding (MMMLU) in eight languages, faithfulness rises as resource level falls on knowledge-intensive tasks but not on reasoning-intensive ones, a gap that points the same way across four models and several faithfulness measures. We propose, and find support for, the Reliance Hypothesis: models rely more on their reasoning when they cannot recall the answer, as in lower-resource languages on knowledge-intensive tasks. Model confidence partly explains the effect of resource level, but not the knowledge-reasoning gap. Languages in which models are less confident rely more on reasoning, yet less confident answers within a language do not, a Simpson's paradox. In lower-resource languages, models rely on their reasoning for more answers, not more strongly for each. CoT monitoring may therefore be most informative in lower-resource languages, where it is least often validated.},
	publisher = {arXiv},
	author = {Resck, Lucas and Sun, Jingyi and Wang, Qianli and Augenstein, Isabelle and Korhonen, Anna},
	month = oct,
	year = {2026},
	abbr = {arXiv},
	arxiv = {2610.22841},
	bibtex_show = true,
	pdf = {http://arxiv.org/pdf/2610.22841},
	preview = {resck_reliance_2026.png},
	google_scholar_id = {mVmsd5A6BfQC},
	additional_info = {*arXiv*},
	selected = {true},
}

@misc{resck_mitigating_2026,
	title = {Mitigating {Cross}-{Lingual} {Cultural} {Inconsistencies} in {LLMs} via {Consensus}-{Driven} {Preference} {Optimisation}},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {http://arxiv.org/abs/2605.12515},
	doi = {10.48550/arXiv.2605.12515},
	abstract = {Multilingual large language models (MLLMs) often answer culturally ambiguous questions inconsistently across languages, even for a fixed user persona -- e.g., Shakespeare in English but Cervantes in Spanish for the same British user. To robustly quantify this Cross-lingual Cultural Inconsistency, we introduce Singleton Fleiss's Kappa, a metric mathematically resilient to hallucinations. For mitigation, we propose Cross-lingual Cultural Consistent Preference Optimisation (C-3PO), a consensus-driven alignment framework. C-3PO raises Kappa by 0.07--0.10 over unaligned models, above every prompting and representation steering baseline averaged across personas, whilst largely preserving explicit user identities, cultural neutrality and intrinsic cultural knowledge; where it does not, a soft-consensus variant recovers most of the cost. Although trained only on multiple-choice questions, C-3PO also improves consistency in open-ended generation. Empirical evaluations demonstrate this inconsistency is more pronounced for lower-resource languages like Indonesian and Persian. Finally, early decoding of intermediate layers reveals that MLLMs implicitly personalise outputs towards the prompt language's stereotypical culture as forward-pass representations stabilise.},
	publisher = {arXiv},
	author = {Resck, Lucas and Augenstein, Isabelle and Korhonen, Anna},
	month = oct,
	year = {2026},
	abbr = {arXiv},
	arxiv = {2605.12515},
	bibtex_show = true,
	pdf = {http://arxiv.org/pdf/2605.12515},
	preview = {resck_mitigating_2026.png},
	google_scholar_id = {M3ejUd6NZC8C},
	additional_info = {*arXiv*},
	selected = {true},
}

@inproceedings{zhou_lower-resource_2026,
	title = {<i>Lower-{Resource}, {Higher} {Scores}</i>: {Language} {Bias} in {LLM} {Evaluators}},
	copyright = {Creative Commons Attribution 4.0 International},
	shorttitle = {Lower-{Resource}, {Higher} {Scores}},
	url = {http://arxiv.org/abs/2607.14480},
	doi = {10.48550/arXiv.2607.14480},
	abstract = {LLM evaluators (trained reward models and prompted LLM-as-a-Judge) are routinely validated via pairwise accuracy. In a multilingual setting, this operates under the premise that high pairwise accuracy implies reliable, language-neutral scoring. We show that this assumption does not hold across languages. We conduct experiments with semantically identical instruction--response pairs across 23 languages, and find that multilingual evaluators assign significantly different scores to different evaluation languages. We show that this bias is statistically significant and consistent across eight evaluators of different architectures and training paradigms, and is strongly correlated with language resource level: lower-resource languages are scored more generously. Meanwhile, these biases are invisible to pairwise accuracy: evaluators would achieve above 90\% pairwise accuracy, yet have 43\% difference in acceptance-rate across languages under a global decision threshold, meaning, for instance, that harmful content in lower-resource languages is more likely to pass safety filters. We then investigate why lower-resource languages receive higher rather than lower scores, and we find that model uncertainty (measured by negative log-likelihood) is linked with the effect: models tend to give higher scores when less confident; however, language identity remains a significant predictor after controlling for uncertainty, and the bias cannot be explained away by content difficulty alone, but is a structural, language-level misalignment.},
	booktitle = {The {Third} {Annual} {Conference} on {Language} {Modeling}},
	author = {Zhou, Ej and Resck, Lucas and Hui*, Zheng and Korhonen*, Anna},
	month = oct,
	year = {2026},
	abbr = {COLM 2026},
	annotation = {* Equal advising.},
	arxiv = {2607.14480},
	bibtex_show = true,
	pdf = {http://arxiv.org/pdf/2607.14480},
	preview = {zhou_lower-resource_2026.png},
	google_scholar_id = {aqlVkmm33-oC},
	selected = {true},
}

@article{resck_legalanalytics_2026,
	title = {{LegalAnalytics}: bridging visual explanations and workload streamline in {Brazilian} {Supreme} {Court} appeals},
	volume = {34},
	copyright = {Copyright © 2025 The Authors. Licensed under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/).},
	issn = {1572-8382},
	shorttitle = {{LegalAnalytics}},
	url = {https://doi.org/10.1007/s10506-025-09446-w},
	doi = {10.1007/s10506-025-09446-w},
	abstract = {The Brazilian Supreme Court serves as the highest judicial authority in Brazil and is responsible for adjudicating constitutional matters presented as extraordinary appeals. These appeals undergo a rigorous screening process guided by established legal principles known as Topics of General Repercussion. Seeking to streamline this procedure, we developed LegalAnalytics to explore the research question: Can machine learning and explainable AI techniques enhance the classification of appeals in legal workflows? LegalAnalytics harnesses advanced natural language processing algorithms and classification models to categorize each appeal according to the most pertinent topics accurately. In addition, it incorporates LIME (Local Interpretable Model-agnostic Explanations) to highlight the key sections of an appeal and compare them with relevant precedents. This approach ensures a transparent justification for every classification. The system is thoughtfully designed with a user-friendly interface tailored for public servants, judges, and lawyers. Extensive testing with dozens of legal experts confirmed the effectiveness of LegalAnalytics, with consistently positive feedback underscoring its significant practical impact.},
	language = {en},
	number = {3},
	journal = {Artificial Intelligence and Law},
	publisher = {Springer Nature},
	author = {Resck, Lucas and Moreno-Vera, Felipe and Veiga, Tobias and Paucar, Gerardo and Fajreldines, Ezequiel and Klafke, Guilherme and Nonato, Luis G. and Poco, Jorge},
	month = sep,
	year = {2026},
	pages = {685--743},
	abbr = {AI \& Law 2026},
	bibtex_show = true,
	html = {https://doi.org/10.1007/s10506-025-09446-w},
	pdf = {https://link.springer.com/content/pdf/10.1007/s10506-025-09446-w.pdf},
	preview = {resck_legalanalytics_2026.jpg},
	google_scholar_id = {kNdYIx-mwKoC},
}

