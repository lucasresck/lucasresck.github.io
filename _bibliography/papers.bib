@inproceedings{hu_culturalriddles_2026,
	address = {Budapest, Hungary},
	title = {{CulturalRiddles}: {A} {Multicultural} {Benchmark} of {Riddles}},
	shorttitle = {{CulturalRiddles}},
	abstract = {Capturing how well LLMs can understand and model the diversity of cultures around the globe has increasingly gained importance as LLMs' language coverage has rapidly advanced. However, existing benchmarks are still knowledge- and English-centric with limited coverage and complexity. We propose CulturalRiddles, a benchmark of culturally-grounded riddles, spanning 61 cultures and 51 languages, created in a participatory community effort. These riddles are both hyper-specific to each culture, require factual knowledge, language skills, social knowledge, and strong abductive reasoning skills to solve. We benchmark 28 LLMs with both automatic and human evaluation and release all artifacts publicly.},
	language = {English},
